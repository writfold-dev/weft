// Contradictory hypotheses must not justify an unrelated conclusion.
review contradictory_planning {
    context "unresolved-sandbox" at "unresolved-release";
    profile "weft.symbolic/1";
    target change = proposal "unresolved-plan";

    assume compatible: client_compatible("sdk-v1");
    assume incompatible: not client_compatible("sdk-v1");

    check unrelated: deployment_safe("production");
}
